{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/SmartNotesAI.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/SmartNotesAI.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start SmartNotes AI Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Stop SmartNotes AI Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Get-Process iisexpress -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'IIS Express stopped.' -ForegroundColor Green"
      ],
      "problemMatcher": []
    }
  ]
}
